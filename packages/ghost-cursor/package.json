{
  "name": "@imuratalpay/ghost-cursor",
  "version": "0.2.0",
  "description": "Live, replayable React component demos. A ghost cursor replays a recording with real DOM events and steps aside when the reader reaches for the component.",
  "license": "MIT",
  "homepage": "https://ghost-cursor.muratalpay.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imuratalpay/ghost-cursor.git",
    "directory": "packages/ghost-cursor"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "motion": "^14.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "demo",
    "cursor",
    "replay",
    "interaction",
    "blog"
  ]
}
