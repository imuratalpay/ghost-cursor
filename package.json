{
  "name": "ghost-cursor-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @imuratalpay/ghost-cursor && npm run build -w site",
    "dev": "npm run build -w @imuratalpay/ghost-cursor && (npm run dev -w @imuratalpay/ghost-cursor & npm run dev -w site)",
    "lint": "npm run lint -w site",
    "test": "npm run build && playwright test",
    "test:e2e": "playwright test",
    "ghost-record": "node skills/ghost-record/scripts/ghost-record.mjs",
    "test:agent": "node tests/agent-e2e/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
